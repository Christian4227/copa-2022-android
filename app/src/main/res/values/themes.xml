<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Copa2022" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/primary_color</item>
        <item name="android:windowBackground">@color/background</item>
    </style>

    <style name="Theme.Copa2022.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/primary_color</item>
        <item name="android:statusBarColor">@color/primary_color</item>
        <item name="postSplashScreenTheme">@style/Theme.Copa2022</item>
    </style>

</resources>